# Ban sensitive file probes (.env, .git, credentials, wp-config etc.)
# Single attempt = ban (always malicious)

[nginx-sensitive-files]
enabled = true
port = http,https
filter = nginx-sensitive-files
logpath = /var/log/nginx/access.log
maxretry = 1
findtime = 3600
bantime = 1h

action = nftables[type=allports]
         pushover-notify[reason="Sensitive file probe (.env/.git/credentials) - BLOCKED"]
         abuseipdb[abuseipdb_category="15,21"]
